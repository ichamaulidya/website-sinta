APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:VsN77pOf+wpIPGyr2+pNXK6eMgfctd586Ydja+zkudU=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ================= DATABASE =================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sinta_web
DB_USERNAME=root
DB_PASSWORD=

# ================= SESSION =================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ================= CACHE =================
CACHE_STORE=file
CACHE_DRIVER=file

# ================= QUEUE =================
QUEUE_CONNECTION=sync

# ================= FILESYSTEM =================
FILESYSTEM_DISK=local

# ================= BROADCAST =================
BROADCAST_CONNECTION=log

# ================= REDIS (TIDAK DIPAKAI, TAPI AMAN) =================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ================= MAIL (LOG MODE) =================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ================= VITE =================
VITE_APP_NAME="${APP_NAME}"